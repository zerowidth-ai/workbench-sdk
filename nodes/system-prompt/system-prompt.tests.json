[
  {
    "description": "A token's fallback is used when its variable is missing",
    "inputs": { "variables": [] },
    "settings": { "content": "Hello {{name:\"there\"}}!" },
    "expected": {
      "message": { "role": "system", "content": [{ "type": "text", "text": "Hello there!", "cache_prefix_length": 6 }] },
      "prompt": "Hello there!"
    }
  },
  {
    "description": "A token's fallback is used when its variable is empty",
    "inputs": { "variables": [{ "name": "  " }] },
    "settings": { "content": "Hello {{name:\"there\"}}!" },
    "expected": {
      "message": { "role": "system", "content": [{ "type": "text", "text": "Hello there!", "cache_prefix_length": 6 }] },
      "prompt": "Hello there!"
    }
  },
  {
    "description": "A variable's value wins over the token's fallback",
    "inputs": { "variables": [{ "name": "Ada" }] },
    "settings": { "content": "Hello {{ name : \"there\" }}!" },
    "expected": {
      "message": { "role": "system", "content": [{ "type": "text", "text": "Hello Ada!", "cache_prefix_length": 6 }] },
      "prompt": "Hello Ada!"
    }
  },
  {
    "description": "A fallback can hold an escaped quote, and spaces inside the braces are allowed",
    "inputs": { "variables": [{ "name": "Ada" }] },
    "settings": { "content": "Hi {{ name }}, say {{greeting:\"\\\"hello\\\"\"}}." },
    "expected": {
      "message": { "role": "system", "content": [{ "type": "text", "text": "Hi Ada, say \"hello\".", "cache_prefix_length": 3 }] },
      "prompt": "Hi Ada, say \"hello\"."
    }
  },
  {
    "description": "String variable is injected as-is",
    "inputs": {
      "variables": [
        {
          "name": "Ada"
        }
      ]
    },
    "settings": {
      "content": "Hello {{name}}!"
    },
    "expected": {
      "message": {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Hello Ada!",
            "cache_prefix_length": 6
          }
        ]
      },
      "prompt": "Hello Ada!"
    }
  },
  {
    "description": "Nested object variable is JSON stringified, not [object Object]",
    "inputs": {
      "variables": [
        {
          "profile": {
            "name": "Ada",
            "langs": [
              "js",
              "py"
            ]
          }
        }
      ]
    },
    "settings": {
      "content": "Profile: {{profile}}"
    },
    "expected": {
      "message": {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Profile: {\n  \"name\": \"Ada\",\n  \"langs\": [\n    \"js\",\n    \"py\"\n  ]\n}",
            "cache_prefix_length": 9
          }
        ]
      },
      "prompt": "Profile: {\n  \"name\": \"Ada\",\n  \"langs\": [\n    \"js\",\n    \"py\"\n  ]\n}"
    }
  },
  {
    "description": "Array of objects delivered as a single connection is flattened",
    "inputs": {
      "variables": [
        [
          {
            "first": "Ada"
          },
          {
            "last": "Lovelace"
          }
        ]
      ]
    },
    "settings": {
      "content": "{{first}} {{last}}"
    },
    "expected": {
      "message": {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Ada Lovelace"
          }
        ]
      },
      "prompt": "Ada Lovelace"
    }
  },
  {
    "description": "Unmatched placeholder is left intact",
    "inputs": {
      "variables": [
        {
          "name": "Ada"
        }
      ]
    },
    "settings": {
      "content": "Hello {{missing}}!"
    },
    "expected": {
      "message": {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "Hello {{missing}}!",
            "cache_prefix_length": 18
          }
        ]
      },
      "prompt": "Hello {{missing}}!"
    }
  }
]
