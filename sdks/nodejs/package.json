  "dependencies": {
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "axios": "^1.9.0",
    "js-tiktoken": "^1.0.21",
    "openai": "^4.92.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tiktoken": "^1.0.22",
    "uuid": "^11.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zerowidth-ai/workbench-sdk.git",
    "directory": "sdks/nodejs"
